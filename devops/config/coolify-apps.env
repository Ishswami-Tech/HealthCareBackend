# Coolify-managed Application UUIDs
# These map (environment, app) pairs to Coolify application UUIDs used by
# devops/scripts/docker-infra/coolify-deploy.sh.
#
# Usage: DEPLOY_ENV=<env> ./coolify-deploy.sh --app <name> --image <image>
# The script resolves: ${ENV_KEY}_${APP_KEY}_UUID
#   e.g., DEPLOY_ENV=preprod --app api  →  PREPROD_API_UUID
#
# NOTE (2026-08-15):
#   - Preprod is managed by Coolify (single resource: api + worker).
#     Traefik proxy handles routing for preprod-backend.ishswami.in.
#   - Production is gated off and managed separately via docker-compose
#     (devops/docker/docker-compose.prod.yml).
#   - preprod-nginx was removed — Coolify's Traefik proxy replaces it.

# --- Preprod (Coolify-managed) ----------------------------------------------
# Resource UUID for the preprod application in Coolify.
# Discovered via: ls /data/coolify/services/ → ix9fceaxa914diauokjleeis
PREPROD_API_UUID="ix9fceaxa914diauokjleeis"
PREPROD_WORKER_UUID="ix9fceaxa914diauokjleeis"

# Preprod listens on internal port 8090 (mapped to host 8090 by Coolify).
PREPROD_API_INTERNAL_PORT=8090
PREPROD_API_HOST_PORT=8090

# --- Production (docker-compose managed, NOT Coolify) -----------------------
# UUIDs are empty — prod deploy is driven by docker-compose + blue-green-deploy.sh.
PROD_API_UUID=""
PROD_WORKER_UUID=""
PROD_API_CONTAINER=latest-api
PROD_WORKER_CONTAINER=latest-worker
PROD_API_HOST_PORT=8088
PROD_WORKER_HOST_PORT=8089

# OpenTelemetry settings for the API and worker when shipping to self-hosted ClickStack.
# Set these in the Temps project environment (API project and Worker project).
# All are standard OTEL_* variables read by the SDK; see src/instrument/otel.ts.
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to turn all OpenTelemetry export off.

# ClickStack collector, published over TLS by the reverse proxy (OTLP/HTTP, no path suffix).
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
# Ingestion key from HyperDX: Team Settings -> API Keys. Secret: store it as a Temps secret.
OTEL_EXPORTER_OTLP_HEADERS=authorization=<clickstack-ingestion-key>

# One service name per process so logs and traces separate cleanly.
# API: healthcare-api   Worker: healthcare-worker
OTEL_SERVICE_NAME=healthcare-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

# Signals. Traces are always on with an endpoint; logs and metrics are opt-in.
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=60000

# Sample 20% of new traces, but always follow the caller's decision.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2
